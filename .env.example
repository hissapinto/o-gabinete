# O Gabinete - Mapa de Similaridade Politica entre Deputados Federais
# Arquivo: .env.example
#
# Integrantes:
#     Caio Ariel Cardoso Saraiva  - RA 10439611
#     Isabela Hissa Pinto         - RA 10441873
#     Kaique Barros Paiva         - RA 10441787
#
# Sintese:
#     Modelo das variaveis de ambiente da versao web. Copie para .env, que
#     nao e versionado, e troque a senha:  cp .env.example .env
#
#     O docker-compose.yml le o .env para montar a DATABASE_URL dos servicos.
#     Em producao as mesmas variaveis sao definidas no painel do Render, e as
#     connection strings do Neon ficam fora do git (ver docs/DEPLOY.md).
#
# Historico de alteracoes:
#     25/09/2026 - Caio - Criacao com as variaveis do banco.
#     04/11/2026 - Caio - FORCAR_CARGA, CORS_ORIGINS e PORT.
#     04/11/2026 - Isabela - ANO_REFERENCIA, para carregar outros anos.

POSTGRES_USER=gabinete
POSTGRES_PASSWORD=SENHA_AQUI
POSTGRES_DB=gabinete

# Ano das votacoes que a carga processa. A 57a legislatura vai de 2023 a 2026.
# Carregue um ano por vez: ANO_REFERENCIA=2023 docker compose up carga
ANO_REFERENCIA=2024

# 1 faz o servico carga recarregar o ano mesmo se ele ja estiver no banco.
# Mais pratico so na hora: FORCAR_CARGA=1 docker compose up carga
FORCAR_CARGA=0

# Origens liberadas no CORS da API, separadas por virgula. Vazio = sem CORS,
# que e o caso do compose (proxy /api/ do nginx) e do Render (rewrite).
CORS_ORIGINS=

# Porta da API. O Render define a sua; no compose a API usa 8000.
PORT=8000
