# Copie para .env (cp .env.example .env) e troque a senha.
POSTGRES_USER=gabinete
POSTGRES_PASSWORD=SENHA_AQUI
POSTGRES_DB=gabinete

# 1 faz o servico carga recarregar o ano mesmo se ele ja estiver no banco.
# Mais pratico so na hora: FORCAR_CARGA=1 docker compose up carga
FORCAR_CARGA=0

# Origens liberadas no CORS da API, separadas por virgula. Vazio = sem CORS,
# que e o caso do compose (proxy /api/ do nginx) e do Render (rewrite).
CORS_ORIGINS=

# Porta da API. O Render define a sua; no compose a API usa 8000.
PORT=8000
